---
import {
  ChapterSideBar,
  ChaptersSheet,
} from "@/components/books/ChapterSideBar";
import type { Heading } from "@/types";
interface Props {
  headings: Heading[];
}
const [_space, _, bookName, __, currentChapter] = Astro.url.pathname.split("/");
---

<main class="flex relative">
  <ChaptersSheet
    client:only="react"
    headings={Astro.props.headings}
    {bookName}
    {currentChapter}
  />
  <slot />
</main>
