---
import type { GetStaticPaths } from "astro";
import Base from "@/layouts/Base.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import type { InferGetStaticPropsType } from "astro";
import ChapterLayout from "@/layouts/ChapterLayout.astro";
import { prettyPrint } from "@/utils/prettyPrint";

export const getStaticPaths = (async () => {
  const chapters: CollectionEntry<"chapters">[] = await getCollection(
    "chapters"
  );

  const books: CollectionEntry<"books">[] = await getCollection("books");

  return chapters.map((chapter) => {
    const [bookName, chapterName] = chapter.slug.split("/");
    return {
      params: {
        chapter: chapterName,
        book: bookName,
      },
      props: { chapter, book: books.find((b) => b.slug === bookName)! },
    };
  });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { chapter, book } = Astro.props as Props;
const { headings } = await book.render();
console.log(headings);

const { Content } = await chapter.render();
---

<Base postData={chapter}>
  <ChapterLayout {headings}>
    <article dir="ltr" class="font-pacamara-space px-7 mx-auto w-full">
      <div
        class="lg:px-0 mb-5 mx-auto prose lg:prose-xl prose-headings:transition-all prose-headings:duration-300 prose-headings:font-pacamara-space prose-headings:font-bold prose-headings:text-pacamara-accent prose-headings:mb-0 prose-headings:pb-3 prose-headings:mt-6 prose-p:transition-all prose-p:duration-300 prose-p:text-pacamara-primary/80 prose-li:transition-all prose-li:duration-300 prose-li:text-pacamara-primary/80 prose-td:transition-all prose-td:duration-300 prose-td:text-pacamara-primary/80 prose-a:underline prose-a:font-semibold prose-a:transition-all prose-a:duration-300 prose-a:text-pacamara-accent hover:prose-a:text-pacamara-dark prose-strong:transition-all prose-strong:duration-300 prose-strong:font-bold prose-hr:transition-all prose-hr:duration-300 prose-hr:border-pacamara-secondary/40 prose-img:rounded-lg prose-img:mx-auto prose-code:transition-all prose-code:duration-300 prose-code:text-pacamara-dark dark:prose-headings:text-pacamara-accent dark:prose-p:text-white/70 dark:prose-a:text-white dark:hover:prose-a:text-pacamara-accent dark:prose-strong:text-white dark:prose-li:text-white dark:prose-code:text-white dark:prose-td:text-white/70 dark:prose-hr:border-pacamara-accent/30 dark:prose-tr:border-pacamara-accent/30 dark:prose-thead:border-pacamara-accent/30"
      >
        <Content />
      </div>
    </article>
  </ChapterLayout>
</Base>
